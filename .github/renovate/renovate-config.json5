{
  $schema: "https://docs.renovatebot.com/renovate-global-schema.json",
  onboarding: true,
  platform: "github",
  platformCommit: "enabled",
  prConcurrentLimit: 0,
  prHourlyLimit: 20,
  semanticCommits: "enabled",
  enabledManagers: ["ansible", "ansible-galaxy", "custom.regex"],
  logLevelRemap: [
    {
      matchMessage: "/^Error updating branch/",
      newLogLevel: "error",
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update the Ansible sanity image within its compatible Core release series",
      managerFilePatterns: ["/^\\.github\\/workflows\\/__shared-ci\\.yml$/"],
      matchStrings: [
        "sanity-image: (?<depName>quay\\.io/ansible/default-test-container):(?<currentValue>v\\d+\\.\\d+-\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "regex:^(?<compatibility>v\\d+\\.\\d+)-(?<patch>\\d+)$",
    },
    {
      customType: "regex",
      description: "Update the Clipboard Indicator release and archive checksum together",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: [
        'clipboard_indicator:\\n(?:[^\\n]*\\n){0,4}?\\s+version: "(?<currentValue>[0-9]+)"\\n\\s+sha256: "(?<currentDigest>[a-f0-9]{64})"',
      ],
      depNameTemplate: "clipboard-indicator",
      datasourceTemplate: "custom.gnome-clipboard",
      versioningTemplate: "regex:^(?<major>[0-9]+)$",
    },
    {
      customType: "regex",
      description: "Update the Vitals system monitor release and archive checksum together",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: [
        'system_monitor:\\n(?:[^\\n]*\\n){0,4}?\\s+version: "(?<currentValue>[0-9]+)"\\n\\s+sha256: "(?<currentDigest>[a-f0-9]{64})"',
      ],
      depNameTemplate: "vitals",
      datasourceTemplate: "custom.gnome-vitals",
      versioningTemplate: "regex:^(?<major>[0-9]+)$",
    },
    {
      customType: "regex",
      description: "Keep the complete system Node distribution on the latest LTS release",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: ['node:\\n\\s+version: "(?<currentValue>[^"]+)"'],
      depNameTemplate: "node-lts",
      datasourceTemplate: "custom.node-lts",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Update the checksum-verified mise release",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: ['mise:\\n\\s+version: "(?<currentValue>[^"]+)"'],
      depNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Advance the single Ubuntu baseline in bootstrap, tooling, and Lima together",
      managerFilePatterns: [
        "/^ansible\\/ubuntu-version$/",
        "/^docker\\/tooling\\/Dockerfile$/",
        "/^e2e-tests\\/lima-ubuntu\\.yml$/",
      ],
      matchStrings: [
        "(?:FROM ubuntu:|releases/|ubuntu-|^)(?<currentValue>\\d{2}\\.\\d{2})",
      ],
      depNameTemplate: "ubuntu-workstation",
      datasourceTemplate: "custom.ubuntu-stable",
      versioningTemplate: "regex:^(?<major>\\d{2})\\.(?<minor>\\d{2})$",
    },
    {
      customType: "regex",
      description: "Update the setup-owned Oh My Zsh revision",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: [
        'workstation_manager_oh_my_zsh_revision: "(?<currentDigest>[0-9a-f]{40})"',
      ],
      depNameTemplate: "ohmyzsh/ohmyzsh",
      packageNameTemplate: "https://github.com/ohmyzsh/ohmyzsh.git",
      datasourceTemplate: "git-refs",
      currentValueTemplate: "master",
    },
    {
      customType: "regex",
      description: "Update the pinned Chezmoi release in public config",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: [
        'chezmoi:\\n(?:[^\\n]*\\n){0,6}?\\s+version:\\s+"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "twpayne/chezmoi",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.+)$",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Update reviewed development tools, npm CLIs and MCP servers",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^\\s]+)\\n\\s+[^\\n]+?:\\s+"(?<currentValue>[^"\\n]+)"',
      ],
      extractVersionTemplate: "^v?(?<version>.+)$",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Propose reviewed Git skill revisions from their annotated branches",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: [
        '# renovate: datasource=git-refs depName=(?<depName>[^\\s]+) branch=(?<currentValue>[^\\s]+)\\n\\s*source:\\s*"(?:https://github\\.com/)?[^"/]+/[^"/]+/tree/(?<currentDigest>[0-9a-f]{40})/[^"\\n]+"',
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{{depName}}}.git",
    },
    {
      customType: "regex",
      description: "Update the mandatory mise PHP runtime from stable upstream tags",
      managerFilePatterns: ["/^ansible\\/group_vars\\/all\\.yml$/"],
      matchStrings: ['"vfox:jdx/vfox-php": "(?<currentValue>[^"]+)"'],
      depNameTemplate: "php/php-src",
      datasourceTemplate: "github-tags",
      extractVersionTemplate: "^php-(?<version>\\d+\\.\\d+\\.\\d+)$",
      versioningTemplate: "semver",
    },
  ],
  customDatasources: {
    // GNOME version/digest snapshots are supplied by ci/renovate_gnome.py via
    // RENOVATE_CUSTOM_DATASOURCES; no version-only fallback is permitted.
    "node-lts": {
      defaultRegistryUrlTemplate: "https://nodejs.org/dist/index.json",
      format: "json",
      transformTemplates: [
        '{"releases": [$[lts != false].{"version": $substring(version, 1), "releaseTimestamp": date}]}',
      ],
    },
    "ubuntu-stable": {
      defaultRegistryUrlTemplate: "https://changelogs.ubuntu.com/meta-release",
      format: "plain",
      transformTemplates: [
        '{"releases": [releases[$match(version, /^Version: [0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?( LTS)?$/)].{"version": $match(version, /^Version: ([0-9]{2}\\.[0-9]{2})/).groups[0]}]}',
      ],
    },
  },
}
