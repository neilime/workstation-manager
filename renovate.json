{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:all"],
  "packageRules": [
    {
      "matchPackageNames": ["clipboard-indicator"],
      "automerge": false,
      "prBodyNotes": [
        "Download the reviewed GNOME Extensions archive, update its SHA-256 in all.yml, and repeat the clipboard Wayland acceptance checks before accepting this update."
      ]
    },
    {
      "matchPackageNames": ["ubuntu-workstation"],
      "groupName": "Ubuntu workstation baseline",
      "automerge": false,
      "ignoreUnstable": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Goss release and Linux x86-64 archive checksum together",
      "managerFilePatterns": ["/^e2e-tests/goss\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<version>[^\"]+)\",\\s*\"sha256\":\\s*\"(?<currentDigest>[a-f0-9]{64})\""],
      "depNameTemplate": "goss-org/goss",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "currentValueTemplate": "v{{{version}}}",
      "autoReplaceStringTemplate": "\"version\": \"{{{replace '^v' '' newValue}}}\",\n\t\"sha256\": \"{{{newDigest}}}\""
    }
  ]
}
